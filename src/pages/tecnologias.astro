---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Badge from "@/components/Badge.astro";
import CloudIcon from "@/assets/icons/Cloud.astro";
import BioIcon from "@/assets/icons/Bio.astro";
import CodeIcon from "@/assets/icons/Code.astro";
import DbIcon from "@/assets/icons/Db.astro";
import SapIcon from "@/assets/icons/Sap.astro";
import OracleIcon from "@/assets/icons/Oracle.astro";
import ApisIcon from "@/assets/icons/Apis.astro";
import MiddlewareIcon from "@/assets/icons/Middleware.astro";
import ServerIcon from "@/assets/icons/Server.astro";
import MaletinIcon from "@/assets/icons/Maletin.astro";
import { Image } from "astro:assets";
import bgCtaPng from "@/assets/images/backgrounds/bg-cta.png";
---

<Layout
  title="Tecnologías y Herramientas | JTI"
  description="Descubre el ecosistema tecnológico que JTI utiliza para impulsar la transformación digital mediante herramientas escalables, seguras y eficientes."
>
  <SectionContainer
    class="w-full max-w-7xl mx-auto py-24 px-4 sm:px-6 lg:px-8 mt-10"
  >
    <div class="text-center mb-20">
      <div class="inline-block uppercase mb-6">
        <Badge title="Ecosistema técnico" />
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-[4rem] font-extrabold text-[#45B3EE] tracking-tight leading-tight mb-6"
      >
        Tecnologías que impulsan la <br class="hidden md:block" />
        <span
          class="bg-[linear-gradient(to_right,#4648d4,#8127cf,#4648d4)] bg-size-[200%_auto] text-transparent bg-clip-text animate-[pan_6s_ease-in-out_infinite_alternate]"
          >transformación digital.</span
        >
      </h1>
      <p class="mt-4 max-w-2xl text-base text-[#464554] mx-auto">
        Seleccionamos las herramientas más avanzadas y robustas para garantizar
        que cada solución sea escalable, segura y eficiente.
      </p>
    </div>

    <div class="flex flex-col gap-6 w-full mb-24">
      <div class="flex flex-col lg:flex-row gap-6 w-full items-stretch">
        <div
          class="bg-white rounded-lg border border-[#E2E8F0] shadow-sm p-8 w-full lg:w-[70%] flex flex-col relative overflow-hidden transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="flex items-center gap-3 mb-4 relative z-10">
            <span
              class="text-[#4648D4] flex items-center justify-center w-6 h-6 [&>svg]:w-full [&>svg]:h-full"
            >
              <CloudIcon />
            </span>
            <h3 class="text-2xl font-bold text-[#191c1e]">Infraestructura</h3>
          </div>
          <p class="text-[#464554] mb-10 max-w-2xl relative z-10 text-base">
            Desplegamos arquitecturas resilientes en la nube, optimizando costos
            y asegurando alta disponibilidad global para sus aplicaciones
            críticas.
          </p>

          <div class="flex flex-wrap gap-4 items-center relative z-10">
            <div
              class="flex items-center justify-center border border-[#C7C4D7] text-[#464554] font-medium px-5 py-2.5 rounded-lg text-sm transition-colors duration-200 hover:border-[#4648D4] hover:text-[#4648D4] hover:bg-[#4648D4]/5 cursor-default"
            >
              Amazon Web Services
            </div>
            <div
              class="flex items-center justify-center border border-[#C7C4D7] text-[#464554] font-medium px-5 py-2.5 rounded-lg text-sm transition-colors duration-200 hover:border-[#4648D4] hover:text-[#4648D4] hover:bg-[#4648D4]/5 cursor-default"
            >
              Microsoft Azure
            </div>
            <div
              class="flex items-center justify-center border border-[#C7C4D7] text-[#464554] font-medium px-5 py-2.5 rounded-lg text-sm transition-colors duration-200 hover:border-[#4648D4] hover:text-[#4648D4] hover:bg-[#4648D4]/5 cursor-default"
            >
              Google Cloud Platform
            </div>
          </div>

          <div
            class="absolute -bottom-2 -right-4 opacity-5 pointer-events-none [&>svg]:w-32.5 [&>svg]:h-32.5"
          >
            <ServerIcon />
          </div>
        </div>

        <div
          class="bg-[#4648D4]/5 rounded-lg border border-[#4648D4]/20 shadow-sm p-8 w-full lg:w-[30%] flex flex-col items-center text-center lg:items-start lg:text-left justify-center transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-xl"
        >
          <div
            class="flex items-center justify-center w-16 h-16 rounded-2xl shadow-sm text-[#4648D4] mb-6 [&>svg]:w-8 [&>svg]:h-8"
          >
            <BioIcon />
          </div>
          <h3 class="text-2xl font-bold text-[#191c1e] mb-4">
            Sistemas Biométricos
          </h3>
          <p class="text-[#464554] mb-8 text-base">
            Integración de reconocimiento facial, dactilar y patrones de voz
            para máxima seguridad en control de acceso.
          </p>
          <a
            href="#"
            class="text-[#4648D4] font-semibold flex items-center gap-2 transition-colors duration-200 hover:text-blue-700 group"
          >
            <span>Explorar soluciones</span>
            <span
              class="inline-block transition-transform duration-200 group-hover:translate-x-1"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
              >
            </span>
          </a>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full items-stretch">
        <div
          class="bg-white rounded-lg border border-[#E2E8F0] shadow-sm p-8 w-full lg:w-1/2 flex flex-col transition-all duration-1000 ease-in-out hover:-translate-y-1 hover:shadow-xl scroll-reveal opacity-0 translate-y-12"
        >
          <div class="flex items-center gap-3 mb-8">
            <span
              class="text-[#4648D4] flex items-center justify-center w-6 h-6 [&>svg]:w-full [&>svg]:h-full"
            >
              <CodeIcon />
            </span>
            <h3 class="text-2xl font-bold text-[#191c1e]">Desarrollo Core</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-auto">
            <div
              class="border border-[#C7C4D7] rounded-lg p-5 flex flex-col justify-center items-start hover:bg-gray-100 transition-colors cursor-default"
            >
              <span class="font-bold text-[#464554]">Python</span>
              <span class="text-sm text-gray-500 mt-1 font-normal"
                >AI & Backend</span
              >
            </div>
            <div
              class="border border-[#C7C4D7] rounded-lg p-5 flex flex-col justify-center items-start hover:bg-gray-100 transition-colors cursor-default"
            >
              <span class="font-bold text-[#464554]">React</span>
              <span class="text-sm text-gray-500 mt-1 font-normal"
                >Modern Web UI</span
              >
            </div>
            <div
              class="border border-[#C7C4D7] rounded-lg p-5 flex flex-col justify-center items-start hover:bg-gray-100 transition-colors cursor-default"
            >
              <span class="font-bold text-[#464554]">Node.js</span>
              <span class="text-sm text-gray-500 mt-1 font-normal"
                >High Performance</span
              >
            </div>
            <div
              class="border border-[#C7C4D7] rounded-lg p-5 flex flex-col justify-center items-start hover:bg-gray-100 transition-colors cursor-default"
            >
              <span class="font-bold text-[#464554]">PHP</span>
              <span class="text-sm text-gray-500 mt-1 font-normal"
                >Enterprise Apps</span
              >
            </div>
          </div>
        </div>

        <div
          class="bg-white rounded-lg border border-[#E2E8F0] shadow-sm p-8 w-full lg:w-1/2 flex flex-col transition-all duration-1000 ease-in-out hover:-translate-y-1 hover:shadow-xl scroll-reveal opacity-0 translate-y-12"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="text-[#4648D4] flex items-center justify-center w-6 h-6 [&>svg]:w-full [&>svg]:h-full"
            >
              <DbIcon />
            </span>
            <h3 class="text-2xl font-bold text-[#191c1e]">Bases de Datos</h3>
          </div>
          <p class="text-[#464554] text-base mb-6">
            Gestión eficiente de datos estructurados y no estructurados con
            enfoque en integridad y latencia mínima.
          </p>

          <div class="space-y-4 mt-auto">
            <div
              class="flex justify-between items-center border-b border-gray-100 pb-3"
            >
              <span class="font-bold text-[#464554] text-sm">PostgreSQL</span>
              <span class="text-xs font-medium text-[#464554]">Relacional</span>
            </div>
            <div
              class="flex justify-between items-center border-b border-gray-100 pb-3"
            >
              <span class="font-bold text-[#464554] text-sm">MongoDB</span>
              <span class="text-xs font-medium text-[#464554]">NoSQL</span>
            </div>
            <div class="flex justify-between items-center pb-1">
              <span class="font-bold text-[#464554] text-sm">SQL Server</span>
              <span class="text-xs font-medium text-[#464554]">Corporativo</span
              >
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col lg:flex-row items-center gap-6 w-full mt-10 scroll-reveal opacity-0 translate-y-12 transition-all duration-1000 ease-in-out"
      >
        <div class="w-full lg:w-1/3">
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-10 h-10 rounded-xl bg-[#4648D4]/5 text-[#8127CF] flex items-center justify-center"
            >
              <MaletinIcon class="w-5 h-5" />
            </div>
            <h3 class="text-2xl font-bold text-[#191c1e]">
              Soluciones Enterprise
            </h3>
          </div>
          <p class="text-[#464554] text-base">
            Unificamos procesos de negocio complejos mediante integraciones de
            alto nivel y personalización de ERPs líderes.
          </p>
        </div>

        <div class="w-full lg:w-2/3 grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div
            class="bg-white border border-[#E2E8F0] shadow-sm rounded-lg p-6 flex flex-col h-full items-center text-center transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-xl cursor-default"
          >
            <div
              class="text-[#191C1E] flex items-center justify-center h-8 mb-2 [&>svg]:h-full [&>svg]:w-auto"
            >
              <SapIcon />
            </div>
            <span class="text-xs font-medium text-[#464554] mt-auto"
              >Implementación</span
            >
          </div>
          <div
            class="bg-white border border-[#E2E8F0] shadow-sm rounded-lg p-6 flex flex-col h-full items-center text-center transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-xl cursor-default"
          >
            <div
              class="text-[#191C1E] flex items-center justify-center h-8 mb-2 [&>svg]:h-full [&>svg]:w-auto"
            >
              <OracleIcon />
            </div>
            <span class="text-xs font-medium text-[#464554] mt-auto"
              >Consultoría</span
            >
          </div>
          <div
            class="bg-white border border-[#E2E8F0] shadow-sm rounded-lg p-6 flex flex-col h-full items-center text-center transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-xl cursor-default"
          >
            <div
              class="flex items-center justify-center mb-2 [&>svg]:h-12 [&>svg]:w-12 text-[#191C1E]"
            >
              <ApisIcon />
            </div>
            <span class="text-xs font-medium text-[#464554] mt-auto"
              >Personalizadas</span
            >
          </div>
          <div
            class="bg-white border border-[#E2E8F0] shadow-sm rounded-lg p-6 flex flex-col h-full items-center text-center transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-xl cursor-default"
          >
            <div
              class="text-[#191C1E] flex items-center justify-center h-8 mb-2 [&>svg]:h-10 [&>svg]:w-10"
            >
              <MiddlewareIcon />
            </div>
            <span class="text-xs font-medium text-[#464554] mt-auto"
              >Middleware</span
            >
          </div>
        </div>
      </div>
    </div>

    <div
      class="w-full bg-[#45B3EE] rounded-lg p-10 md:p-16 text-center text-white relative overflow-hidden shadow-xl z-0 scroll-reveal opacity-0 translate-y-12 transition-all duration-1000 ease-in-out"
    >
      <Image
        alt="Fondo de modernización"
        class="absolute inset-0 w-full h-full object-cover -z-10 mix-blend-screen opacity-70"
        src={bgCtaPng}
      />

      <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight">
          ¿Listo para modernizar su stack?
        </h2>
        <p class="text-blue-50 mb-10 text-base font-light">
          Nuestros arquitectos están preparados para diseñar la solución que su
          empresa necesita para escalar al siguiente nivel.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center w-full sm:w-auto"
        >
          <a
            href="/contacto"
            class="bg-[#E9531C] text-white border-none px-6 py-3 rounded-lg font-medium shadow-lg hover:shadow-xl text-center transition-transform duration-300 ease-out hover:scale-105"
          >
            Agendar consultoría técnica
          </a>
          <a
            href="/casos-de-exito"
            class="bg-[#E8E1D6] text-[#000000] border-none px-6 py-3 rounded-lg font-medium text-center transition-transform duration-300 ease-out hover:scale-105"
          >
            Ver Casos de Éxito
          </a>
        </div>
      </div>
    </div>
  </SectionContainer>
</Layout>

<script>
  const setupObserver = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-12");
            entry.target.classList.add("opacity-100", "translate-y-0");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.25,
        rootMargin: "0px 0px -50px 0px",
      },
    );

    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      observer.observe(el);
    });
  };

  document.addEventListener("DOMContentLoaded", setupObserver);
  document.addEventListener("astro:page-load", setupObserver);
</script>

<style>
  @keyframes pan {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 100% center;
    }
  }
</style>
