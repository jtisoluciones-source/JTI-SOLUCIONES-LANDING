---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/Badge.astro";
import Cards from "@/components/ui/Card.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import GroupUsers from "@/assets/icons/GroupUsers.astro";
import BiometricIcon from "@/assets/icons/BiometricIcon.astro";
import ServerIcon from "@/assets/icons/ServerIcon.astro";
---

<Layout
  title="Servicios de JTI"
  description="Explora los servicios que JTI ofrece a sus clientes, diseñados para satisfacer las necesidades de la industria del tabaco. Descubre cómo nuestras soluciones innovadoras pueden ayudarte a alcanzar tus objetivos comerciales."
>
  <main class="pt-20">
    <section
      class="flex flex-col md:flex-row items-start gap-12 p-10 md:p-32 mb-16 bg-gradient-to-br from-[#FFFFFF] to-[#D4ABEB]"
    >
      <div class="ml-0 md:ml-[5rem] w-full md:w-auto">
        <Badge
          id="catalogo-soluciones"
          title="Catálogo de soluciones"
          class="w-max inline-flex items-center justify-center"
        />
        <h1 class="max-w-2xl text-left font-bold text-4xl md:text-5xl mt-6">
          Soluciones técnicas para el éxito corporativo.
        </h1>
        <p class="mt-6 text-left text-base md:text-lg text-gray-700 max-w-lg">
          Potenciamos su operatividad mediante servicios integrales de hardware,
          software y consultoría técnica especializada.
        </p>
      </div>
    </section>
    <section>
      <div class="grid grid-cols-3 gap-[2rem] p-[3rem]">
        <Cards
          titulo="Biométricos y asistencia"
          descripcion={`Implementación de sistemas avanzados de control
            de acceso y gestión de tiempo mediante reconocimiento facial, 
            dactilar e iris.`}
          items={["Integración con API de terceros", "Reportes en tiempo real"]}
        >
          <BiometricIcon slot="icono" class="w-12 h-auto text-[#E9531C]" />
        </Cards>
        <Cards
          titulo="Infraestructura y servidores"
          descripcion={`Diseño y despliegue de arquitectura de red robusta, 
          servidores físicos y virtualización de alto rendimiento.`}
          items={[
            "Monitoreo 24/7 de disponibilidad",
            "Escalabilidad garantizada",
          ]}
        >
          <ServerIcon slot="icono" class="w-12 h-auto text-[#E9531C]" />
        </Cards>
        <Cards
          titulo="Equipos de cómputo"
