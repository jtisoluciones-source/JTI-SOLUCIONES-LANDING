---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/Badge.astro";
import Cards from "@/components/ui/Card.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import GroupUsers from "@/assets/icons/GroupUsers.astro";
import BiometricIcon from "@/assets/icons/BiometricIcon.astro";
import ServerIcon from "@/assets/icons/ServerIcon.astro";
import SectionContainer from "@/components/SectionContainer.astro";
---

<Layout
  title="Servicios de JTI"
  description="Explora los servicios que JTI ofrece a sus clientes, diseñados para satisfacer las necesidades de la industria del tabaco. Descubre cómo nuestras soluciones innovadoras pueden ayudarte a alcanzar tus objetivos comerciales."
>
  <main class="pt-20">
    <SectionContainer
      id="catalogo-soluciones"
      class="w-full max-w-none bg-gradient-to-b from-[#ffffff] via-[#f4efff] to-[#e9d8ff] px-0"
    >
      <div class="mx-auto flex w-full max-w-7xl flex-col items-start gap-6 px-5 py-10 sm:px-8 md:px-12 md:py-16 lg:px-20">
        <div class="w-full md:ml-10 lg:ml-16">
          <Badge
            id="catalogo-soluciones"
            title="Catálogo de soluciones"
            class="w-max inline-flex items-center justify-center"
          />
          <h1 class="mt-6 max-w-3xl text-left text-4xl font-black leading-[0.96] tracking-[-0.05em] text-[#111827] sm:text-5xl lg:text-[4rem]">
            Infraestructura técnica para el éxito corporativo.
          </h1>
          <p class="mt-6 max-w-xl text-left text-base leading-7 text-[#4b5563] md:text-lg">
            Potenciamos su operatividad mediante servicios integrales de hardware,
            software y consultoría técnica especializada.
          </p>
        </div>
      </div>
    </SectionContainer>

    <SectionContainer class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
      <div class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
        <Cards
          titulo="Biométricos y asistencia"
          descripcion="Implementación de sistemas avanzados de control de acceso y gestión de tiempo mediante reconocimiento facial, dactilar e iris."
          items={["Integración con API de terceros", "Reportes en tiempo real"]}
        >
          <BiometricIcon slot="icono" class="h-7 w-7 text-[#E9531C]" />
        </Cards>

        <Cards
          titulo="Infraestructura y servidores"
          descripcion="Diseño y despliegue de arquitectura de red robusta, servidores físicos y virtualización de alto rendimiento."
          items={["Monitoreo 24/7 de disponibilidad", "Escalabilidad garantizada"]}
        >
          <ServerIcon slot="icono" class="h-7 w-7 text-[#E9531C]" />
        </Cards>

        <Cards
          titulo="Equipos de cómputo"
          descripcion="Suministro y mantenimiento de estaciones de trabajo, portátiles y periféricos de última generación para personal administrativo."
          items={["Garantía extendida onsite", "Configuración de software base"]}
        >
          <svg
            slot="icono"
            class="h-7 w-7"
            viewBox="0 0 48 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect width="48" height="48" rx="8" fill="#E9531C" fill-opacity="0.1"></rect>
            <path d="M10.846 34.7564C10.2494 34.7564 9.737 34.5423 9.3088 34.1141C8.8806 33.6859 8.6665 33.1735 8.6665 32.5769H13.7434C13.0699 32.5769 12.4998 32.3436 12.0332 31.8769C11.5665 31.4103 11.3332 30.8402 11.3332 30.1667V15.6539C11.3332 14.9804 11.5665 14.4103 12.0332 13.9436C12.4998 13.477 13.0699 13.2437 13.7434 13.2437H34.2562C34.9297 13.2437 35.4997 13.477 35.9664 13.9436C36.4331 14.4103 36.6664 14.9804 36.6664 15.6539V30.1667C36.6664 30.8402 36.4331 31.4103 35.9664 31.8769C35.4997 32.3436 34.9297 32.5769 34.2562 32.5769H39.3331C39.3331 33.1735 39.119 33.6859 38.6908 34.1141C38.2626 34.5423 37.7502 34.7564 37.1536 34.7564H10.846ZM23.9998 33.7564C24.3006 33.7564 24.5553 33.6521 24.7639 33.4436C24.9724 33.2351 25.0767 32.9804 25.0767 32.6795C25.0767 32.3787 24.9724 32.124 24.7639 31.9154C24.5553 31.7069 24.3006 31.6026 23.9998 31.6026C23.6989 31.6026 23.4442 31.7069 23.2357 31.9154C23.0272 32.124 22.9229 32.3787 22.9229 32.6795C22.9229 32.9804 23.0272 33.2351 23.2357 33.4436C23.4442 33.6521 23.6989 33.7564 23.9998 33.7564ZM13.7434 30.577H34.2562C34.3587 30.577 34.4528 30.5342 34.5382 30.4488C34.6237 30.3633 34.6665 30.2693 34.6665 30.1667V15.6539C34.6665 15.5513 34.6237 15.4573 34.5382 15.3718C34.4528 15.2863 34.3587 15.2436 34.2562 15.2436H13.7434C13.6408 15.2436 13.5468 15.2863 13.4613 15.3718C13.3759 15.4573 13.3331 15.5513 13.3331 15.6539V30.1667C13.3331 30.2693 13.3759 30.3633 13.4613 30.4488C13.5468 30.5342 13.6408 30.577 13.7434 30.577ZM13.3331 30.577C13.3331 30.577 13.3331 30.5342 13.3331 30.4488C13.3331 30.3633 13.3331 30.2693 13.3331 30.1667V15.6539C13.3331 15.5513 13.3331 15.4573 13.3331 15.3718C13.3331 15.2863 13.3331 15.2436 13.3331 15.2436C13.3331 15.2436 13.3331 15.2863 13.3331 15.3718C13.3331 15.4573 13.3331 15.5513 13.3331 15.6539V30.1667C13.3331 30.2693 13.3331 30.3633 13.3331 30.4488C13.3331 30.5342 13.3331 30.577 13.3331 30.577Z" fill="#E9531C"></path>
          </svg>
        </Cards>

        <Cards
          titulo="Equipos de oficina"
          descripcion="Soluciones integrales de impresión, escaneo y gestión documental digitalizada para optimizar flujos de trabajo."
          items={["Suministro gestionado de insumos", "Reducción de costos de impresión"]}
        >
          <svg
            slot="icono"
            class="h-7 w-7"
            viewBox="0 0 48 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect width="48" height="48" rx="8" fill="#E9531C" fill-opacity="0.1"></rect>
            <path d="M29.3336 18.8718V14.8718H18.6669V18.8718H16.667V12.8719H31.3335V18.8718H29.3336ZM13.7182 20.8718C13.7182 20.8718 13.846 20.8718 14.1015 20.8718C14.3571 20.8718 14.6738 20.8718 15.0515 20.8718H32.9489C33.3267 20.8718 33.6434 20.8718 33.8989 20.8718C34.1545 20.8718 34.2823 20.8718 34.2823 20.8718H31.3335H16.667H13.7182ZM31.7438 24.2051C32.1216 24.2051 32.4383 24.0773 32.6938 23.8218C32.9494 23.5662 33.0771 23.2496 33.0771 22.8718C33.0771 22.494 32.9494 22.1773 32.6938 21.9218C32.4383 21.6662 32.1216 21.5385 31.7438 21.5385C31.366 21.5385 31.0494 21.6662 30.7938 21.9218C30.5382 22.1773 30.4105 22.494 30.4105 22.8718C30.4105 23.2496 30.5382 23.5662 30.7938 23.8218C31.0494 24.0773 31.366 24.2051 31.7438 24.2051ZM29.3336 33.1282V27.4359H18.6669V33.1282H29.3336ZM31.3335 35.1282H16.667V29.7948H11.7183V22.2051C11.7183 21.2607 12.0409 20.469 12.6862 19.8302C13.3315 19.1913 14.1199 18.8718 15.0515 18.8718H32.9489C33.8934 18.8718 34.685 19.1913 35.3239 19.8302C35.9628 20.469 36.2822 21.2607 36.2822 22.2051V29.7948H31.3335V35.1282ZM34.2823 27.7949V22.2051C34.2823 21.8273 34.1545 21.5107 33.8989 21.2551C33.6434 20.9996 33.3267 20.8718 32.9489 20.8718H15.0515C14.6738 20.8718 14.3571 20.9996 14.1015 21.2551C13.846 21.5107 13.7182 21.8273 13.7182 22.2051V27.7949H16.667V25.4359H31.3335V27.7949H34.2823Z" fill="#E9531C"></path>
          </svg>
        </Cards>

        <Cards
          titulo="Equipos especializados"
          descripcion="Adquisición de hardware crítico para entornos industriales, laboratorios o requerimientos técnicos de nicho."
          items={["Búsqueda global de componentes", "Instalación técnica certificada"]}
        >
          <svg
            slot="icono"
            class="h-7 w-7"
            viewBox="0 0 48 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect width="48" height="48" rx="8" fill="#E9531C" fill-opacity="0.1"></rect>
            <path d="M13.8372 35.5525V32.4757H17.9193L14.4936 21.2654C13.9022 20.9577 13.4227 20.5116 13.0552 19.927C12.6877 19.3423 12.5039 18.6962 12.5039 17.9885C12.5039 16.9714 12.8607 16.106 13.5744 15.3924C14.2881 14.6787 15.1535 14.3219 16.1705 14.3219C17.0116 14.3219 17.7475 14.5719 18.3782 15.0719C19.009 15.5719 19.4406 16.2108 19.6731 16.9885H24.2475V15.3218C24.2475 15.0381 24.3432 14.8005 24.5346 14.609C24.7261 14.4176 24.9637 14.3219 25.2475 14.3219C25.4218 14.3219 25.5842 14.3663 25.7346 14.4552C25.885 14.5441 26.0013 14.6689 26.0833 14.8296V15.0091L28.4269 12.8244C28.6184 12.633 28.8402 12.5138 29.0923 12.4667C29.3444 12.4197 29.591 12.4586 29.832 12.5834L34.9551 14.9578C35.1705 15.0655 35.3239 15.2214 35.4154 15.4257C35.5068 15.63 35.5055 15.833 35.4115 16.0347C35.3038 16.2501 35.1479 16.3881 34.9436 16.4488C34.7393 16.5094 34.5363 16.4928 34.3346 16.3988L29.4064 14.1218L26.2474 17.0552V18.9218L29.4064 21.7885L34.3346 19.5116C34.5363 19.4176 34.7427 19.4043 34.9538 19.4718C35.1649 19.5394 35.3175 19.674 35.4115 19.8757C35.5192 20.0911 35.5239 20.2975 35.4256 20.4949C35.3273 20.6923 35.1705 20.8449 34.9551 20.9526L29.832 23.368C29.591 23.4927 29.3444 23.5295 29.0923 23.4782C28.8402 23.4269 28.6184 23.3098 28.4269 23.1269L26.0833 20.968V21.1475C26.0013 21.2808 25.885 21.3987 25.7346 21.5013C25.5842 21.6039 25.4218 21.6551 25.2475 21.6551C24.9637 21.6551 24.7261 21.5594 24.5346 21.368C24.3432 21.1765 24.2475 20.9389 24.2475 20.6552V18.9885H19.6731C19.6064 19.2261 19.515 19.4569 19.3987 19.6808C19.2825 19.9047 19.1449 20.1099 18.9859 20.2962L25.55 32.4757H30.5039V35.5525H13.8372ZM16.1705 19.6552C16.6338 19.6552 17.0274 19.4932 17.3513 19.1693C17.6753 18.8454 17.8372 18.4518 17.8372 17.9885C17.8372 17.5252 17.6753 17.1317 17.3513 16.8077C17.0274 16.4838 16.6338 16.3218 16.1705 16.3218C15.7073 16.3218 15.3137 16.4838 14.9898 16.8077C14.6658 17.1317 14.5039 17.5252 14.5039 17.9885C14.5039 18.4518 14.6658 18.8454 14.9898 19.1693C15.3137 19.4932 15.7073 19.6552 16.1705 19.6552ZM19.9859 32.4757H23.2526L17.3654 21.5269C17.297 21.5697 17.1894 21.606 17.0423 21.6359C16.8953 21.6658 16.7705 21.6722 16.668 21.6551L19.9859 32.4757Z" fill="#E9531C"></path>
          </svg>
        </Cards>

        <Cards
          titulo="Desarrollo de software"
          descripcion="Creación de aplicaciones web, móviles y herramientas internas a medida con enfoque en la experiencia de usuario."
          items={["Metodologías ágiles (Scrum)", "Código escalable y documentado"]}
        >
          <svg
            slot="icono"
            class="h-7 w-7"
            viewBox="0 0 48 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect width="48" height="48" rx="8" fill="#E9531C" fill-opacity="0.1"></rect>
            <path d="M18.6668 31.5384L11.1284 24L18.6668 16.4615L20.0925 17.8872L13.9591 24.0205L20.0719 30.1333L18.6668 31.5384ZM29.3335 31.5384L27.9079 30.1128L34.0412 23.9795L27.9284 17.8666L29.3335 16.4615L36.8719 24L29.3335 31.5384Z" fill="#E9531C"></path>
          </svg>
        </Cards>
      </div>

      <div class="mt-8 lg:mt-12">
        <div class="rounded-[22px] border border-[#dfe3f0] bg-[#f5f5f5] p-4 sm:p-5 lg:p-7">
          <div class="grid gap-5 lg:grid-cols-[0.95fr_1.75fr] lg:items-center">
            <div class="flex items-start gap-3">
              <div class="mt-1 flex h-12 w-12 items-center justify-center rounded-xl bg-[#ede7ff] text-[#7c4dff]">
                <GroupUsers class="h-7 w-7" />
              </div>
              <div>
                <h2 class="text-[1.65rem] font-black leading-tight tracking-[-0.04em] text-[#111827]">
                  Soporte y asesoría Nómina/RH
                </h2>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <FeatureCard
                texto="Soporte directo en la integración de datos y seguridad de la información sensible."
                className="bg-[#edf5ff]"
              >
                <span slot="titulo" class="inline-flex items-center gap-2 text-[#1b1b1b]">
                  <svg width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2 8.5L6 12.5L16 2.5" stroke="#8127CF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  Acompañamiento Técnico
                </span>
              </FeatureCard>

              <FeatureCard
                texto="Automatización de flujos de trabajo para reducir el margen de error en cálculos legales."
                className="bg-[#eefcff]"
              >
                <span slot="titulo" class="inline-flex items-center gap-2 text-[#1b1b1b]">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M3 9.5L6.5 13L15 4.5" stroke="#8127CF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  Optimización de Procesos
                </span>
              </FeatureCard>
            </div>
          </div>
        </div>
      </div>
    </SectionContainer>

    <SectionContainer class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="rounded-[32px] bg-[#1f1f22] px-6 py-10 text-center shadow-lg sm:px-8 lg:px-12 lg:py-12">
        <h2 class="text-balance text-2xl font-black tracking-[-0.04em] text-white sm:text-3xl lg:text-[2.25rem]">
          ¿Listo para transformar su infraestructura?
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-[#e5e7eb] sm:text-lg">
          Nuestro equipo de expertos está listo para diseñar una solución a la medida de su organización.
        </p>
        <button class="mt-7 inline-flex items-center justify-center rounded-xl bg-[#5f39ff] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[#5f39ff]/20 transition hover:bg-[#4c2ae8] sm:px-7 sm:py-3.5 sm:text-base">
          Agendar una Consultoría Técnica
        </button>
      </div>
    </SectionContainer>
  </main>
</Layout>
