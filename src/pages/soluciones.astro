---
import Layout from "@/layouts/Layout.astro";
import HeroDiagnostico from "@/components/solutions/HeroDiagnostico.astro";
import ImpactMetrics from "@/components/solutions/ImpactMetrics.astro";
import ProblemGrid from "@/components/solutions/ProblemGrid.astro";
import CtaSoluciones from "@/components/solutions/CtaSoluciones.astro";
import { operationalProblems } from "@/data/soluciones";
---

<Layout title="Soluciones de JTI" description="...">
  <main class="mt-32 pb-16">
    <HeroDiagnostico />

    <section class="mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[minmax(240px,0.8fr)_minmax(0,1.7fr)]">
        <ImpactMetrics />
        <ProblemGrid problems={operationalProblems} />
      </div>
    </section>

    <CtaSoluciones />
  </main>
</Layout>