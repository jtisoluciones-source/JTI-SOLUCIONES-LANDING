---
interface Props {
  title: string;
  iconPath: string;
  iconColors: string;
  symptoms: string[];
  solution: string;
}

const { title, iconPath, iconColors, symptoms, solution } = Astro.props;
---

<article class="rounded-3xl border border-[#e5e7eb] bg-[#f8f8f8] p-4 shadow-[0_8px_24px_rgba(15,23,42,0.04)]">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class={`flex h-10 w-10 items-center justify-center rounded-lg ${iconColors}`}>
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path d={iconPath} />
        </svg>
      </div>
      <h3 class="text-[0.72rem] font-black uppercase tracking-[0.14em] text-[#1f2937]">
        {title}
      </h3>
    </div>
    <span class="inline-flex h-2.5 w-2.5 rounded-full bg-[#ef4444]"></span>
  </div>

  <div class="rounded-xl border border-[#e5e7eb] bg-white/40 p-3">
    <div class="flex items-center gap-2 text-[0.72rem] font-black uppercase tracking-[0.14em] text-[#ef4444]">
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
        <path d="M12 2.75a9.25 9.25 0 1 0 9.25 9.25A9.26 9.26 0 0 0 12 2.75Zm0 4.5a1.1 1.1 0 0 1 1.1 1.1v4.95a1.1 1.1 0 0 1-2.2 0V8.35A1.1 1.1 0 0 1 12 7.25Zm0 10.9a1.25 1.25 0 1 1 1.25-1.25A1.25 1.25 0 0 1 12 18.15Z" />
      </svg>
      Síntomas
    </div>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-[#1f2937]">
      {symptoms.map((symptom) => <li>{symptom}</li>)}
    </ul>
  </div>

  <div class="mt-4 rounded-xl border border-[#bfead0] bg-[#def8eb] p-3">
    <div class="flex items-center gap-2 text-[0.72rem] font-black uppercase tracking-[0.12em] text-[#1e7d5c]">
      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#2bb673] text-xs text-white">✓</span>
      Solución JTI
    </div>
    <p class="mt-2 text-sm leading-6 text-[#1f2937]">{solution}</p>
  </div>
</article>
