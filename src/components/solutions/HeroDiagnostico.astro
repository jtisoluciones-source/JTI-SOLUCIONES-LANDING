---
import Badge from "@/components/Badge.astro";
import SectionContainer from "@/components/SectionContainer.astro";
---

<SectionContainer
  id="diagnostico-avanzado"
  class="mx-auto w-full max-w-7xl px-4 py-8 text-center sm:px-6 lg:px-8"
>
  <div class="mx-auto text-center">
    <Badge
      id="diagnostico-avanzado"
      title="DIAGNOSTICO AVANZADO"
      class="mx-auto mb-6 mt-[7vmin] block w-fit"
    />

    <h2 class="text-4xl font-black tracking-[-0.06em] text-[#260700] sm:text-5xl lg:text-[4.2rem]">
      Desafíos Operativos y
    </h2>
    <h2
      class="mt-2 bg-linear-to-r from-[#45B3EE] via-[#2E7CEB] to-[#2E3DD4] bg-clip-text text-4xl font-black tracking-[-0.06em] text-transparent sm:text-5xl lg:text-[4.2rem]"
    >
      Soluciones Estratégicas
    </h2>

    <p class="mx-auto mt-6 max-w-4xl rounded-lg p-4 text-base font-medium leading-7 text-[#4b5563] sm:text-lg sm:leading-8">
      JTI identifica y resuelve los cuellos de botella técnicos críticos que limitan el crecimiento de tu organización a través de ingeniería de precisión.
    </p>
  </div>
</SectionContainer>