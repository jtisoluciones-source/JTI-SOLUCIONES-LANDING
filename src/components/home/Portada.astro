---
import LogoColor from "@/assets/images/backgrounds/jti.astro";
import Badge from "@/components/Badge.astro";
---

<div class="flex justify-center">
  <LogoColor class="w-56 sm:w-72 lg:w-[26rem] h-auto mb-5 sm:mb-7 lg:mb-9" />
</div>
<div class="flex justify-center mb-6 sm:mb-8">
  <Badge id="innovacion" title="INNOVACIÓN DIGITAL" />
</div>
<div class="mx-auto max-w-5xl text-center">
  <h2 class="text-4xl font-black leading-[0.95] tracking-[-0.04em] text-[#260700] sm:text-5xl lg:text-7xl">
    Tecnología inteligente para
  </h2>
  <h2
    class="mt-2 text-4xl font-black leading-[0.95] tracking-[-0.04em] bg-gradient-to-r from-[#45B3EE] via-[#2E6BE6] to-[#2E3DD4] bg-clip-text text-transparent animate-pulse sm:text-5xl lg:text-7xl"
  >
    empresas modernas
  </h2>
  <p
    class="mx-auto mt-5 max-w-2xl rounded-2xl border border-[#260700]/10 bg-white/45 px-4 py-4 text-center text-sm leading-7 text-slate-600 shadow-[0_12px_30px_rgba(38,7,0,0.04)] backdrop-blur-sm sm:px-6 sm:text-base lg:mt-6 lg:text-lg"
  >
    "La arquitectura del mañana se construye con la precisión del código de hoy.
    Transformamos la complejidad en fluidez operativa."
  </p>
</div>
