---
import LogoColor from "@/assets/images/backgrounds/jti.astro";
import Badge from "@/components/Badge.astro";
---

<div class="flex justify-center">
  <LogoColor class="w-96 h-auto mb-8" />
</div>
<div class="flex justify-center mb-8">
  <Badge id="innovacion" title="INNOVACIÓN DIGITAL" />
</div>
<div class="mx-auto text-center">
  <h2 class="text-7xl font-bold text-[#260700]">Tecnología inteligente para</h2>
  <h2
    class="text-7xl font-bold bg-gradient-to-r from-[#45B3EE] to-[#2E3DD4] bg-clip-text text-transparent animate-pulse"
  >
    empresas modernas
  </h2>
  <p
    class="mx-auto mt-4 max-w-xl text-center text-lg leading-8 text-gray-600 p-8 rounded-lg font-medium italic"
  >
    "La arquitectura del mañana se construye con la precisión del código de hoy.
    Transformamos la complejidad en fluidez operativa."
  </p>
</div>
