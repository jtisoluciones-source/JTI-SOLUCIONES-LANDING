---
import CodeIcon from "@/assets/icons/CodeIcon.astro";
import CloudIcon from "@/assets/icons/CloudIcon.astro";
import CyberIcon from "@/assets/icons/CyberIcon.astro";
import SystemIcon from "@/assets/icons/SystemIcon.astro";
---
<div class="flex justify-center gap-4 mb-8">
  <button
    class="bg-gradient-to-r from-[#45B3EE] to-[#2E3DD4] text-white px-6 py-2.5 rounded-xl hover:bg-[#3a0f00] transition-all font-medium"
  >
    Explora el Portafolio
  </button>
  <a href="/quienes-somos"
    class="bg-white text-[#260700] px-6 py-2.5 rounded-xl hover:bg-[#F9F3E9] border border-[#260700]/50 transition-all font-medium"
  >
    Nuestra Visión
  </a>
</div>
<div class="mx-auto text-center">
  <div class="flex items-center justify-center gap-6">
    <p class="text-lg leading-8 text-gray-600 flex items-center gap-2">
      <CodeIcon class="w-5 h-5" />AI INTEGRATION
    </p>
    <p class="text-lg leading-8 text-gray-600 flex items-center gap-2">
      <CloudIcon class="w-5 h-5" />CLOUD NATIVE
    </p>
    <p class="text-lg leading-8 text-gray-600 flex items-center gap-2">
      <CyberIcon class="w-5 h-5" />CYBER SECURITY
    </p>
    <p class="text-lg leading-8 text-gray-600 flex items-center gap-2">
      <SystemIcon class="w-5 h-5" />SYSTEM DESIGN
    </p>
  </div>
</div>
