<script>
  const footerBreakpoint = window.matchMedia("(min-width: 1024px)");

  const setPanelState = (
    button: HTMLButtonElement,
    panel: HTMLElement,
    expanded: boolean,
  ) => {
    button.setAttribute("aria-expanded", String(expanded));
    button.setAttribute(
      "aria-label",
      `${expanded ? "Ocultar" : "Mostrar"} ${button.dataset.label ?? "sección"}`,
    );
    panel.hidden = !expanded;
    panel.setAttribute("aria-hidden", String(!expanded));
    const indicator = button.querySelector("span");
    if (indicator) indicator.textContent = expanded ? "−" : "+";
  };

  const syncFooterPanels = () => {
    const footer = document.querySelector<HTMLElement>("[data-site-footer]");
    if (!footer) return;

    footer.querySelectorAll<HTMLButtonElement>("button[data-toggle]").forEach(
      (button) => {
        const panelId = button.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!(panel instanceof HTMLElement) || !footer.contains(panel)) return;
        setPanelState(button, panel, footerBreakpoint.matches);
      },
    );
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || footerBreakpoint.matches) return;

    const button = target.closest<HTMLButtonElement>(
      "[data-site-footer] button[data-toggle]",
    );
    if (!button) return;

    const panelId = button.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!(panel instanceof HTMLElement)) return;

    setPanelState(
      button,
      panel,
      button.getAttribute("aria-expanded") !== "true",
    );
  });

  document.addEventListener("astro:page-load", syncFooterPanels);
  footerBreakpoint.addEventListener("change", syncFooterPanels);
  syncFooterPanels();
</script>
